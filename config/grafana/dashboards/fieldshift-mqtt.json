    {
      "id": 9,
      "type": "table",
      "title": "Topics en el periodo",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fieldshift"
      },
      "description": "Topic = fieldshift/<cliente>/<baliza>/<tipo>. Último = minuto en el que se contó el último mensaje.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fieldshift"
          },
          "query": "from(bucket: \"mqtt\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_topic\")\n  |> group(columns: [\"topic\", \"dispositivo\", \"tipo\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> reduce(identity: {mensajes: 0.0, bytes: 0.0, ultimo: time(v: 0)},\n            fn: (r, accumulator) => ({mensajes: accumulator.mensajes + float(v: r.mensajes_sum),\n                                      bytes: accumulator.bytes + float(v: r.bytes_sum),\n                                      ultimo: if r._time > accumulator.ultimo then r._time else accumulator.ultimo}))\n  |> map(fn: (r) => ({dispositivo: r.dispositivo, tipo: r.tipo, mensajes: r.mensajes,\n                      tamano: if r.mensajes > 0.0 then r.bytes / r.mensajes else 0.0, ultimo: r.ultimo}))\n  |> group() |> sort(columns: [\"dispositivo\", \"tipo\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dispositivo"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Baliza"
              },
              {
                "id": "custom.width",
                "value": 240
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
