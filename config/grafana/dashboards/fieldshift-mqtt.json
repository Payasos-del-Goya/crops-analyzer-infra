                        "text": "Rojo (b5434D4)",
                        "index": 0
                      },
                      "bA78B10": {
                        "text": "Azul (bA78B10)",
                        "index": 1
                      },
                      "bA6FDA8": {
                        "text": "Amarillo (bA6FDA8)",
                        "index": 2
                      },
                      "bA7F8F8": {
                        "text": "Naranja (bA7F8F8)",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tipo"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tipo"
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mensajes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Mensajes"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tamano"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tamaño medio"
              },
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ultimo"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Último mensaje"
              },
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
