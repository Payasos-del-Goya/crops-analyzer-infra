    {
      "id": 5,
      "type": "timeseries",
      "title": "Mensajes por minuto",
      "description": "Enviados > recibidos es normal: cada mensaje se reparte a cada suscriptor.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fieldshift"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fieldshift"
          },
          "query": "import \"date\"\nfrom(bucket: \"mqtt\") |> range(start: date.sub(d: 7d, from: v.timeRangeStart), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mosquitto\" and r.metrica == \"load/messages/received/1min\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> fill(usePrevious: true)\n  |> filter(fn: (r) => r._time >= v.timeRangeStart and exists r._value)\n  |> keep(columns: [\"_time\", \"_value\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fieldshift"
          },
          "query": "import \"date\"\nfrom(bucket: \"mqtt\") |> range(start: date.sub(d: 7d, from: v.timeRangeStart), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mosquitto\" and r.metrica == \"load/messages/sent/1min\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> fill(usePrevious: true)\n  |> filter(fn: (r) => r._time >= v.timeRangeStart and exists r._value)\n  |> keep(columns: [\"_time\", \"_value\"])"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fieldshift"
          },
          "query": "import \"date\"\nfrom(bucket: \"mqtt\") |> range(start: date.sub(d: 7d, from: v.timeRangeStart), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mosquitto\" and r.metrica == \"load/publish/dropped/1min\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> fill(usePrevious: true)\n  |> filter(fn: (r) => r._time >= v.timeRangeStart and exists r._value)\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": 600000,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": [
