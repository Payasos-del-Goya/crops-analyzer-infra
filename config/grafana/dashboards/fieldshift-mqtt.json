    {
      "id": 8,
      "type": "timeseries",
      "title": "Mensajes por minuto de cada baliza",
      "description": "Cada placa manda suelo y atmósfera cada ~30 s y estado cada ~60 s (~5 mensajes/min). Si una baja a 0, ha dejado de llegar al broker.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fieldshift"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fieldshift"
          },
          "query": "from(bucket: \"mqtt\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_topic\" and r._field == \"mensajes_sum\")\n  |> group(columns: [\"dispositivo\"])\n  |> aggregateWindow(every: 1m, fn: sum, createEmpty: false)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"dispositivo\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": 600000,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.dispositivo}",
          "decimals": 1
        },
        "overrides": [
