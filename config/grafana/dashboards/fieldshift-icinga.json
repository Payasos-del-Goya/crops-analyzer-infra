    {
      "id": 2,
      "type": "stat",
      "title": "Checks con problema",
      "description": "Checks de Icinga que no están en OK (hosts DOWN incluidos). El detalle, en la tabla.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fieldshift"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fieldshift"
          },
          "query": "from(bucket: \"icinga\") |> range(start: -1h)\n  |> filter(fn: (r) => r._field == \"state\")\n  |> last()\n  |> group(columns: [\"hostname\", \"service\"])\n  |> sort(columns: [\"_time\"]) |> last()\n  |> map(fn: (r) => ({r with estado: if exists r.service then int(v: r._value) else (if int(v: r._value) == 0 then 0 else 2)}))\n  |> filter(fn: (r) => r.estado != 0)\n  |> group() |> count(column: \"estado\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
