    {
      "id": 7,
      "type": "table",
      "title": "Balizas ahora",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fieldshift"
      },
      "description": "Último estado de cada placa. Reinicios = veces que el uptime volvió a empezar en el periodo elegido.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fieldshift"
          },
          "query": "base = from(bucket: \"icinga\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"fieldshift-baliza\" and r.service == \"estado baliza\" and r._field == \"value\"\n                       and (r.metric == \"uptime\" or r.metric == \"rssi\" or r.metric == \"heap_bloque\" or r.metric == \"edad\"))\nultimos = base |> group(columns: [\"hostname\", \"metric\"]) |> last()\n  |> group(columns: [\"hostname\"]) |> pivot(rowKey: [\"hostname\"], columnKey: [\"metric\"], valueColumn: \"_value\")\nreinicios = base |> filter(fn: (r) => r.metric == \"uptime\") |> group(columns: [\"hostname\"]) |> sort(columns: [\"_time\"])\n  |> difference() |> map(fn: (r) => ({hostname: r.hostname, reinicios: if r._value < 0.0 then 1 else 0}))\n  |> sum(column: \"reinicios\")\njoin(tables: {a: ultimos, b: reinicios}, on: [\"hostname\"])\n  |> group() |> keep(columns: [\"hostname\", \"edad\", \"reinicios\", \"uptime\", \"rssi\", \"heap_bloque\"])\n  |> sort(columns: [\"hostname\"])"
        }
      ],
