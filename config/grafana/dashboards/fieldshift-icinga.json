    {
      "id": 5,
      "type": "table",
      "title": "Checks",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-fieldshift"
      },
      "description": "Último resultado de cada check, los que fallan primero. Detalle y acciones en Icinga Web.",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 20,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-fieldshift"
          },
          "query": "from(bucket: \"icinga\") |> range(start: -1h)\n  |> filter(fn: (r) => r._field == \"state\")\n  |> last()\n  |> group(columns: [\"hostname\", \"service\"])\n  |> sort(columns: [\"_time\"]) |> last()\n  |> map(fn: (r) => ({r with estado: if exists r.service then int(v: r._value) else (if int(v: r._value) == 0 then 0 else 2)}))\n  |> map(fn: (r) => ({host: r.hostname, check: if exists r.service then r.service else \"host\",\n                      estado: r.estado, comprobado: r._time, orden: 0 - r.estado}))\n  |> group()\n  |> sort(columns: [\"orden\", \"host\", \"check\"])\n  |> drop(columns: [\"orden\"])"
        }
      ],
