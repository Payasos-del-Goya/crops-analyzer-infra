[Unit]
Description=plot-advisor: frontend (Next.js, contenedor Docker)
Requires=docker.service
After=docker.service network-online.target plotadvisor-backend.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/plotadvisor/crops-analyzer-infra
ExecStart=/usr/bin/docker compose -p plotadvisor -f compose.yaml -f raspberry/compose.raspberry.yaml up --no-deps --no-build frontend
ExecStop=/usr/bin/docker compose -p plotadvisor -f compose.yaml -f raspberry/compose.raspberry.yaml stop frontend
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
